# Copy to .env and replace the password before starting Docker Compose.
POSTGRES_DB=smartfare
POSTGRES_USER=smartfare
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_PORT=5432

PREFECT_PORT=4200
API_PORT=8000
STREAMLIT_PORT=8501

# Provider credentials. Add a real provider token only after enabling that account.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
# Travelpayouts Data API token from your Travelpayouts developer account.
TRAVELPAYOUTS_TOKEN=
# mock works without credentials. Options: mock, amadeus, travelpayouts.
SMARTFARE_PROVIDER=mock
SMARTFARE_MAX_REQUESTS_PER_RUN=25
